{
  "expo": {
    "name": "Siddhanta Shikamani",
    "slug": "siddhanta-shikamani",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "scheme": "siddhantashikamani",
    "splash": {
      "image": "./assets/Splash1.jpg",
      "backgroundColor": "#FFFFFF",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.msvglobaltech.siddhantashikamani",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.msvglobaltech.siddhantashikamani",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [],
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "abi": [
              "armeabi-v7a",
              "arm64-v8a",
              "x86_64"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b9641b95-0848-443e-a51e-1f085b367ddf"
      }
    }
  }
}
